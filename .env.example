# Credenciales del entorno local. Copia este archivo como `.env` y cambia los
# valores si quieres. Los valores de aqui son de ejemplo y son ACRES DECHASABLES:
# no son secretos reales y no deben salir del taller.
#
# Ninguna de estas variables se versiona: `.env` esta en `.gitignore`.

# Superusuario de PostgreSQL (solo dentro del contenedor).
POSTGRES_SUPERUSER_PASSWORD=postgres_local_pwd

# Base de ordenes: rol propietario (solo migraciones) y rol de aplicacion.
ORDERS_OWNER_PASSWORD=orders_owner_local_pwd
ORDERS_USER_PASSWORD=orders_user_local_pwd

# Base de citas: rol propietario (solo migraciones) y rol de aplicacion.
APPOINTMENT_OWNER_PASSWORD=appointment_owner_local_pwd
APPOINTMENT_USER_PASSWORD=appointment_user_local_pwd

# Broker: usuario propio y vhost dedicado (nunca guest/guest).
RABBITMQ_DEFAULT_USER=workshop
RABBITMQ_DEFAULT_PASS=workshop_local_pwd
RABBITMQ_DEFAULT_VHOST=workshop

# Actor de desarrollo para la auditoria. Lo sustituye el sujeto del JWT cuando
# exista el bloque de autenticacion.
APP_ACTOR=dev-advisor
